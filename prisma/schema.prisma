// ==============================================================================
// Orqestra — Phase 0 schema
//
// Scope discipline: only the tables required for the foundation are modelled.
// Tools, Datasets, Evaluations, Experiments, and Memory remain domain concepts
// (see src/modules/*) until their phases land — they will be additive tables.
//
// pgvector readiness: the docker-compose image is pgvector-based, and all
// high-churn payloads use Json columns, so embedding columns/extension can be
// added later via migration without restructuring existing tables.
// ==============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7 convention).
datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// Authentication (Better Auth adapter models)
// ------------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  // Required by Better Auth (expiring verification tokens).
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// Tenancy: Workspace → Project
// ------------------------------------------------------------------------------

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  projects    Project[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("owner")
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id                String            @id @default(cuid())
  workspaceId       String
  name              String
  slug              String
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents            Agent[]
  harnesses         Harness[]
  datasets          Dataset[]
  evaluators        Evaluator[]
  evaluationBatches EvaluationBatch[]
  experiments       Experiment[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// ------------------------------------------------------------------------------
// Agent — identity, purpose, base instructions, model configuration.
// An Agent never encodes *how* it behaves; that belongs to Harness.
// ------------------------------------------------------------------------------

model Agent {
  id             String         @id @default(cuid())
  projectId      String
  name           String
  slug           String
  description    String?
  currentVersion Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       AgentVersion[]
  harnesses      Harness[]
  runs           Run[]
  evaluationBatches EvaluationBatch[]
  experiments    Experiment[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model AgentVersion {
  id           String   @id @default(cuid())
  agentId      String
  version      Int
  /** What the agent is for — displayed on the agent overview. */
  purpose      String?
  instructions Json
  modelConfig  Json
  capabilities Json?
  createdBy    String?
  createdAt    DateTime @default(now())
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
}

enum HarnessStatus {
  DRAFT
  VALID
  INVALID
  ARCHIVED
}

// ------------------------------------------------------------------------------
// Harness — behavior engineering: reasoning flow, tools, memory, loops,
// termination. Harness rows are mutable shells; HarnessVersion rows are
// immutable, content-hashed snapshots (reproducible configurations).
// ------------------------------------------------------------------------------

model Harness {
  id             String          @id @default(cuid())
  projectId      String
  /** A harness belongs to an agent; the agent supplies identity/config. */
  agentId        String?
  name           String
  slug           String
  description    String?
  currentVersion Int             @default(1)
  /** Denormalised from the current definition for fast lists (draft first, else latest version). */
  nodeCount      Int             @default(0)
  edgeCount      Int             @default(0)
  /** Derived from the current draft/definition: DRAFT until validated. */
  status         HarnessStatus   @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  versions       HarnessVersion[]
  draft          HarnessDraft?
  runs           Run[]
  evaluationBatches EvaluationBatch[]
  experimentCandidates ExperimentCandidate[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([agentId])
}

/**
 * The editable working copy of a harness. Drafts are mutable and autosaved;
 * publishing copies a draft into an immutable HarnessVersion.
 */
model HarnessDraft {
  id         String   @id @default(cuid())
  harnessId  String   @unique
  definition Json
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  harness    Harness  @relation(fields: [harnessId], references: [id], onDelete: Cascade)
}

model HarnessVersion {
  id           String   @id @default(cuid())
  harnessId    String
  version      Int
  name         String
  // Full HarnessDefinition (nodes/edges/entry/exits) as validated JSON.
  definition   Json
  // Stable SHA-256 of the canonical serialization — dedup + reproducibility.
  contentHash  String
  entryNode    String
  // Published versions are validated before insert, so this is VALID by
  // construction today; kept explicit for imports/audit.
  status       String   @default("VALID")
  releaseNotes String?
  createdBy    String?
  createdAt    DateTime @default(now())
  harness      Harness  @relation(fields: [harnessId], references: [id], onDelete: Cascade)
  runs         Run[]
  evaluations  EvaluationBatch[]
  experimentCandidates ExperimentCandidate[]

  @@unique([harnessId, version])
  @@index([harnessId, contentHash])
}

// ------------------------------------------------------------------------------
// Run / Trace — observability model designed up-front so the future Run Lab
// UI (Phase 3) needs no schema redesign. Every run pins the exact
// HarnessVersion that produced it.
// ------------------------------------------------------------------------------

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum StepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Run {
  id               String        @id @default(cuid())
  harnessId        String
  harnessVersionId String
  // Denormalised pins for quick filtering (nullable: harness-only runs are legal
  // in Phase 0; agent attribution becomes required once runtime lands).
  agentId          String?
  agent            Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentVersion     Int?
  status           RunStatus     @default(QUEUED)
  input            Json
  output           Json?
  tokenUsage       Json?
  cost             Float?
  latencyMs        Int?
  error            Json?
  // Runtime provenance: engine version, harness content hash, limits, node
  // inventory, provider pins. Immutable once the run starts.
  metadata         Json?
  // Retry chain: a retry creates a NEW run that points at its predecessor.
  attempt          Int           @default(1)
  retryOfRunId     String?
  // Set by POST /runs/:id/cancel; the runtime observes it between nodes and in
  // every in-flight provider/tool call.
  cancelRequestedAt DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  harness          Harness       @relation(fields: [harnessId], references: [id], onDelete: Cascade)
  harnessVersion   HarnessVersion @relation(fields: [harnessVersionId], references: [id], onDelete: Restrict)
  steps            RunStep[]
  events           RuntimeEvent[]
  usage            UsageRecord[]
  evaluations      EvaluationResult[]

  @@index([harnessVersionId])
  @@index([harnessId, status])
  @@index([agentId, createdAt])
  @@index([createdAt])
}

model RunStep {
  id         String     @id @default(cuid())
  runId      String
  // Position in the execution order; unique per run for stable timeline UI.
  index      Int
  nodeId     String
  nodeType   String
  nodeLabel  String
  status     StepStatus @default(PENDING)
  input      Json?
  output     Json?
  error      Json?
  // Executor specifics: branch taken, condition explanation, tool id, plan size…
  metadata   Json?
  // Loop iteration at the time the step ran (null outside loops).
  iteration  Int?
  startedAt  DateTime?
  completedAt DateTime?
  durationMs Int?
  createdAt  DateTime   @default(now())
  run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  trace      Trace?

  @@unique([runId, index])
  @@index([runId])
}

// One trace document per step: ordered runtime events (node/llm/tool/loop).
model Trace {
  id         String   @id @default(cuid())
  runStepId  String   @unique
  events     Json
  createdAt  DateTime @default(now())
  runStep    RunStep  @relation(fields: [runStepId], references: [id], onDelete: Cascade)
}

// Run-level event log: the ground truth for the timeline, SSE replay and
// future evaluation/analytics. Steps carry a per-step trace; this table keeps
// the full ordered stream (including run-level events).
model RuntimeEvent {
  id      String   @id @default(cuid())
  runId   String
  // Monotonic per run, assigned by the runtime event emitter.
  seq     Int
  type    String
  payload Json
  at      DateTime
  createdAt DateTime @default(now())
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, type])
}

// Provider-independent usage aggregation: one row per (run, provider, model).
model UsageRecord {
  id               String   @id @default(cuid())
  runId            String
  provider         String
  model            String
  calls            Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  // Null when the model has no known price — never guessed.
  costUsd          Float?
  createdAt        DateTime @default(now())
  run              Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, provider, model])
  @@index([runId])
}

// ==============================================================================
// Phase 3 — Run Lab, Observability & Evaluation Engine
//
//   Dataset / DatasetVersion / DatasetCase — repeatable test inputs
//   Evaluator / EvaluatorVersion           — reusable scoring procedures
//   EvaluationBatch / CaseResult / Result  — one batch of scored runs
//
// The same immutability rule as harnesses applies one level up: a dataset has
// a mutable working set (`DatasetCase` rows) and immutable, content-hashed
// `DatasetVersion` snapshots; an `Evaluator` has mutable metadata and immutable
// `EvaluatorVersion` revisions. A batch pins a harness version, a dataset
// version and a snapshot of every evaluator it used, so a stored result can be
// interpreted exactly the same way a year later.
//
// Evaluation is deliberately *not* a column on Run: one run can be scored by
// many evaluators at different times, and an evaluator failure must never
// change the run's own execution status. `EvaluationResult.runId` is therefore
// an independent, indexed link (SetNull on run deletion) rather than a cascade.
// ==============================================================================

enum EvaluationBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum EvaluationCaseStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum EvaluationResultStatus {
  COMPLETED
  ERROR
  SKIPPED
}

/** How an aggregate score treats evaluators that produced no usable score. */
enum ScoringPolicy {
  /** Require every weighted evaluator to produce a score. */
  REQUIRE_ALL
  /** Renormalise over the evaluators that did produce a score. */
  IGNORE_MISSING
}

/** Whether an aggregate covered everything it was asked to score. */
enum AggregateStatus {
  COMPLETE
  INCOMPLETE
  FAILED
}

// ------------------------------------------------------------------------------
// Datasets
// ------------------------------------------------------------------------------

model Dataset {
  id             String           @id @default(cuid())
  projectId      String
  name           String
  slug           String
  description    String?
  currentVersion Int              @default(1)
  /** Denormalised for lists: number of cases in the mutable working set. */
  caseCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases          DatasetCase[]
  versions       DatasetVersion[]
  batches        EvaluationBatch[]
  experiments    Experiment[]

  @@unique([projectId, slug])
  @@index([projectId])
}

/** One row of the mutable working set. `caseKey` is the stable identity. */
model DatasetCase {
  id             String   @id @default(cuid())
  datasetId      String
  /** Stable, dataset-unique key used to align batches and comparisons. */
  caseKey        String
  name           String?
  input          Json
  expectedOutput Json?
  metadata       Json?
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dataset        Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, caseKey])
  @@index([datasetId])
}

/**
 * Immutable snapshot of every case at publish time. Batches pin a version, so
 * editing the working set later cannot silently change what a stored batch
 * means.
 */
model DatasetVersion {
  id          String            @id @default(cuid())
  datasetId   String
  version     Int
  name        String
  /** DatasetCase-shaped snapshot array. */
  cases       Json
  caseCount   Int
  contentHash String
  createdBy   String?
  createdAt   DateTime          @default(now())
  dataset     Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  batches     EvaluationBatch[] @relation("BatchDatasetVersion")
  experiments Experiment[]      @relation("ExperimentDatasetVersion")

  @@unique([datasetId, version])
  @@index([datasetId, contentHash])
}

// ------------------------------------------------------------------------------
// Evaluators
// ------------------------------------------------------------------------------

model Evaluator {
  id             String             @id @default(cuid())
  projectId      String
  name           String
  slug           String
  description    String?
  /** One of the built-in evaluator kinds (see src/modules/evaluation). */
  kind           String
  enabled        Boolean            @default(true)
  currentVersion Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       EvaluatorVersion[]

  @@unique([projectId, slug])
  @@index([projectId])
}

/** Immutable revision of an evaluator's configuration. */
model EvaluatorVersion {
  id          String    @id @default(cuid())
  evaluatorId String
  version     Int
  name        String
  kind        String
  description String?
  /** Kind-specific configuration, validated against the evaluator's schema. */
  config      Json
  /** Default weight in [0, 1] used when a batch does not override it. */
  weight      Float     @default(0)
  contentHash String
  createdBy   String?
  createdAt   DateTime  @default(now())
  evaluator   Evaluator @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([evaluatorId, version])
  @@index([evaluatorId, contentHash])
}

// ------------------------------------------------------------------------------
// Evaluation batches
// ------------------------------------------------------------------------------

model EvaluationBatch {
  id                String                @id @default(cuid())
  projectId         String
  /** Human label, e.g. "Regression run — v3 vs v4". */
  label             String?
  agentId           String
  harnessId         String
  harnessVersionId  String
  datasetId         String
  datasetVersionId  String
  /** Snapshot of the dataset cases actually executed (immutable at start). */
  datasetSnapshot   Json
  /** Snapshot: [{ key, evaluatorId, version, kind, name, weight, config }]. */
  evaluatorConfig   Json
  /** Snapshot of the harness version's definition hash + label. */
  harnessSnapshot   Json
  scoringPolicy     ScoringPolicy         @default(REQUIRE_ALL)
  /** Minimum weighted score for a case to count as passed (null = per-evaluator only). */
  passThreshold     Float?
  status            EvaluationBatchStatus @default(PENDING)
  caseCount         Int
  completedCount    Int                   @default(0)
  failedCount       Int                   @default(0)
  /** Aggregated metrics, computed when the batch reaches a terminal status. */
  metrics           Json?
  /** Batch execution settings: concurrency, per-case limits, runner. */
  config            Json
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent             Agent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  harness           Harness               @relation(fields: [harnessId], references: [id], onDelete: Restrict)
  harnessVersion    HarnessVersion        @relation(fields: [harnessVersionId], references: [id], onDelete: Restrict)
  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  datasetVersion    DatasetVersion        @relation("BatchDatasetVersion", fields: [datasetVersionId], references: [id], onDelete: Restrict)
  cases             EvaluationCaseResult[]
  results           EvaluationResult[]
  experimentReplicates ExperimentCandidateReplicate[]

  @@index([projectId, createdAt])
  @@index([harnessVersionId])
  @@index([datasetId])
  @@index([status])
}

/** One dataset case inside a batch: its run, its scores, its status. */
model EvaluationCaseResult {
  id              String               @id @default(cuid())
  batchId         String
  /** Stable test-case identifier from the dataset snapshot. */
  caseKey         String
  /** Position in the dataset snapshot (0-based). */
  index           Int
  name            String?
  status          EvaluationCaseStatus @default(PENDING)
  /** The agent run this case produced (null when run creation failed). */
  runId           String?
  inputPreview    String?
  expectedOutput  Json?
  tags            String[]             @default([])
  /** Weighted aggregate across this case's results. */
  aggregateScore  Float?
  aggregateStatus AggregateStatus?
  /** Structured failure: run failure or evaluator failure — never both fused. */
  error           Json?
  attempts        Int                  @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  batch           EvaluationBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  results         EvaluationResult[]

  // Idempotency: redelivering a case job cannot create a second case row.
  @@unique([batchId, caseKey])
  @@index([batchId, status])
  @@index([runId])
}

/** One evaluator's verdict on one run (case-level or standalone). */
model EvaluationResult {
  id               String                @id @default(cuid())
  batchId          String?
  caseResultId     String?
  runId            String?
  evaluatorId      String?
  evaluatorVersion Int?
  /** Snapshot identity so a result survives evaluator edits/deletion. */
  evaluatorKey     String
  evaluatorName    String
  kind             String
  status           EvaluationResultStatus @default(COMPLETED)
  score            Float?
  maxScore         Float                 @default(1)
  normalizedScore  Float?
  passed           Boolean?
  explanation      String?
  evidence         Json?
  durationMs       Int?
  metadata         Json?
  createdAt        DateTime              @default(now())
  batch            EvaluationBatch?      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  caseResult       EvaluationCaseResult? @relation(fields: [caseResultId], references: [id], onDelete: Cascade)
  run              Run?                  @relation(fields: [runId], references: [id], onDelete: SetNull)

  // Idempotency: one verdict per evaluator per case, even under redelivery.
  @@unique([caseResultId, evaluatorKey])
  @@index([runId])
  @@index([batchId])
  @@index([caseResultId])
}

// ==============================================================================
// Phase 4 — Harness Experiments & A/B Testing
//
//   Experiment          — a sealed comparison of harness versions over one dataset
//   ExperimentCandidate — one immutable harness version (baseline or candidate),
//                         executed through exactly one sealed EvaluationBatch
//   ExperimentRun       — the assignment of one dataset case to one candidate
//
// Sealing works exactly as it does for an evaluation batch: at launch the
// experiment snapshots the dataset version and its cases, every evaluator
// revision, the objective, the constraints and the execution settings. Editing a
// dataset, an evaluator or a harness afterwards cannot change what a stored
// experiment means.
//
// Two deliberate restrictions:
//  - ExperimentCandidate pins `harnessVersionId` (never "latest") *and* the
//    EvaluationBatch that executes it, so a candidate cannot drift to a newer
//    harness version while the experiment runs. Execution itself is the Phase 3
//    engine — the experiment layer schedules, it never re-implements a runtime.
//  - ExperimentRun carries no mutable status. Execution status, the run id and
//    the evaluator verdicts are read through the linked case row of the
//    candidate's batch (one writer, no duplicated state); the assignment row
//    owns only what this layer owns — which case, which candidate, and the order
//    in which they were scheduled.
// ==============================================================================

enum ExperimentStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum ExperimentCandidateRole {
  BASELINE
  CANDIDATE
}

enum ExperimentSelectionKind {
  RECOMMENDED
  SELECTED
}

model Experiment {
  id        String           @id @default(cuid())
  projectId String
  agentId   String
  name      String
  description String?
  /** The hypothesis under test, e.g. "a critic loop raises correctness by 10%". */
  hypothesis String?
  status    ExperimentStatus @default(DRAFT)

  // --- sealed references (written once, at launch) ---------------------------
  datasetId         String
  datasetVersionId  String
  /** DatasetCase-shaped snapshot of the cases this experiment executes. */
  datasetSnapshot   Json
  /** Snapshot: [{ key, evaluatorId, version, kind, name, weight, config, usesLlm }]. */
  evaluatorConfig   Json
  scoringPolicy     ScoringPolicy @default(REQUIRE_ALL)
  passThreshold     Float?
  /** Primary metric, secondary metrics and their optimization directions. */
  objective         Json
  /** Hard constraints a winner must respect (cost, latency, pass rate, budget). */
  constraints       Json
  /** Concurrency, ordering, replicates, timeout, retry policy, budget. */
  execution         Json
  /**
   * Complete immutable configuration snapshot, written at launch. Null while the
   * experiment is still a draft — a draft has intentions, not sealed evidence.
   */
  configSnapshot    Json?

  caseCount         Int @default(0)
  /** Planned executions: dataset cases × candidates × replicates. */
  plannedRunCount   Int @default(0)
  /** Aggregate metrics, recomputed whenever the experiment settles. */
  metrics           Json?

  // --- candidate selection and promotion (audited, never automatic) ----------
  selectedCandidateId String?
  selectionKind       ExperimentSelectionKind?
  selectionNotes      String?
  selectedBy          String?
  selectedAt          DateTime?
  promotedCandidateId String?
  promotionNotes      String?
  promotedBy          String?
  promotedAt          DateTime?

  cancelRequestedAt DateTime?
  pausedAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent          Agent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  dataset        Dataset               @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  datasetVersion DatasetVersion        @relation("ExperimentDatasetVersion", fields: [datasetVersionId], references: [id], onDelete: Restrict)
  candidates     ExperimentCandidate[]
  runs           ExperimentRun[]

  @@index([projectId, createdAt])
  @@index([agentId, createdAt])
  @@index([status])
  @@index([datasetVersionId])
}

model ExperimentCandidate {
  id           String                  @id @default(cuid())
  experimentId String
  /** Human label, unique within the experiment ("Baseline", "critic-loop"). */
  label        String
  role         ExperimentCandidateRole @default(CANDIDATE)
  /** What this candidate is expected to improve, when the author stated one. */
  hypothesis   String?
  /** Candidate order inside one interleaving round (lower runs first). */
  orderIndex   Int

  // --- immutable harness pin -------------------------------------------------
  harnessId        String
  harnessVersionId String
  harnessVersion   Int
  contentHash      String
  /** Snapshot: harness name, version, content hash, node/edge counts, entry node. */
  harnessSnapshot  Json

  createdAt DateTime @default(now())

  experiment        Experiment                       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  harness           Harness                          @relation(fields: [harnessId], references: [id], onDelete: Restrict)
  harnessVersionRef HarnessVersion                   @relation(fields: [harnessVersionId], references: [id], onDelete: Restrict)
  replicates        ExperimentCandidateReplicate[]
  runs              ExperimentRun[]

  @@unique([experimentId, label])
  @@index([experimentId, orderIndex])
  @@index([harnessVersionId])
}

/**
 * One repeated trial of a candidate: a sealed EvaluationBatch per replicate, so
 * a nondeterministic agent can be sampled more than once without merging trials
 * into a single number. With `replicates = 1` (the default) a candidate has
 * exactly one row here, which keeps the common path simple.
 */
model ExperimentCandidateReplicate {
  id                String @id @default(cuid())
  candidateId       String
  /** 1-based replicate index; replicate 1 is the primary trial. */
  replicate         Int
  evaluationBatchId String
  createdAt         DateTime @default(now())

  candidate ExperimentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  batch     EvaluationBatch     @relation(fields: [evaluationBatchId], references: [id], onDelete: Restrict)

  @@unique([candidateId, replicate])
  @@index([evaluationBatchId])
}

model ExperimentRun {
  id               String @id @default(cuid())
  experimentId     String
  candidateId      String
  /** Denormalised from the experiment: the dataset version every case is pinned to. */
  datasetVersionId String
  /** Stable dataset case identity — the key every comparison aligns on. */
  caseKey          String
  /** Position of the case in the dataset snapshot (0-based). */
  index            Int
  /** Global scheduling position across candidates (interleaved, or randomized). */
  orderIndex       Int
  /** 1-based replicate this assignment belongs to (1 when replicates = 1). */
  replicate        Int      @default(1)
  createdAt        DateTime @default(now())

  experiment Experiment          @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  candidate  ExperimentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([experimentId, candidateId, replicate, caseKey])
  @@index([experimentId, orderIndex])
  @@index([candidateId])
}
