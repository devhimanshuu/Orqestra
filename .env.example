# ==============================================================================
# Orqestra environment configuration
# Copy to `.env` and adjust values:  cp .env.example .env
#
# Classification:
#   [required]            — app refuses to start without a valid value
#   [optional]            — app starts without it
#   [provider-specific]   — only needed to enable a specific LLM provider
#   [development-only]    — safe defaults for local development
#   [production-only]     — must be replaced with real values in production
# Never commit real secrets.
# ==============================================================================

# [required][provider: postgresql] Connection string for PostgreSQL.
# Local dev default matches docker-compose.yml:  docker compose up -d
DATABASE_URL="postgresql://orqestra:orqestra@localhost:5432/orqestra?schema=public"

# [optional][provider: neon] Neon Auth (hosted Better Auth). When AUTH_URL is
# set, the app proxies /api/auth/* to it and resolves sessions against it
# instead of running self-hosted Better Auth. Both values come from the Neon
# console when Neon Auth is enabled on the database.
AUTH_URL=""
JWKS_URL=""

# [required][provider: redis] Connection string for Redis (queues, caching).
REDIS_URL="redis://localhost:6379"

# [required][production-only] Secret used to sign auth sessions/tokens.
# Generate a real one for production:  openssl rand -base64 48
BETTER_AUTH_SECRET="dev-only-better-auth-secret-change-me-please-0123456789"

# ------------------------------------------------------------------------------
# [optional] Application settings (sane defaults for local development)
# ------------------------------------------------------------------------------
# Public base URL of the app (used by auth redirects and auth origin checks).
APP_URL="http://localhost:3000"
# [optional] Extra origins allowed to call /api/auth/* — comma-separated,
# wildcards supported (e.g. "https://app.example.com,https://*.example.com").
# Development additionally trusts any localhost/127.0.0.1 port automatically.
BETTER_AUTH_TRUSTED_ORIGINS=""
# One of: debug | info | warn | error
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# [optional][provider-specific] LLM provider credentials.
# The app runs without any of these; providers report "not configured" at call time.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# [optional][provider: ollama] Local Ollama server (no API key required).
OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------------------------
# [optional][development-only] Seed settings used by `pnpm db:seed`.
# ------------------------------------------------------------------------------
SEED_USER_EMAIL="demo@orqestra.dev"
SEED_USER_PASSWORD="orqestra-demo-password"
